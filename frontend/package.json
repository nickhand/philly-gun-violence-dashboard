{
  "name": "philly-gun-violence-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/generate-seo-content.mjs",
    "build:lighthouse": "vue-tsc --noEmit && VITE_LIGHTHOUSE=true VITE_API_BASE_URL= VITE_POSTHOG_KEY= vite build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium --project=mobile-chrome",
    "test:e2e:a11y": "playwright test --grep @a11y",
    "test:lighthouse": "npm run build:lighthouse && lhci autorun --config=./lighthouserc.cjs"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@types/d3-transition": "^3.0.9",
    "@types/maplibre-gl": "^1.13.2",
    "@unhead/vue": "^2.1.1",
    "arquero": "^8.0.3",
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-format": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-selection": "^3.0.0",
    "d3-time-format": "^4.1.0",
    "d3-transition": "^3.0.1",
    "maplibre-gl": "^2.4.0",
    "pinia": "^2.1.7",
    "posthog-js": "^1.318.1",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2",
    "vuetify": "^3.7.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.62.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-format": "^3.0.4",
    "@types/d3-scale": "^4.0.2",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-time-format": "^4.0.3",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^20.12.12",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^26.1.0",
    "typescript": "^5.5.3",
    "vite": "^7.3.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vite-plugin-vuetify": "^2.1.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.2.2"
  }
}
