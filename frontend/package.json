{
  "name": "philly-gun-violence-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:nuxt": "nuxt dev",
    "build": "nuxt build",
    "build:nuxt": "nuxt build",
    "build:nuxt:cloudflare": "npm run build:nuxt:cloudflare:staging",
    "build:nuxt:cloudflare:staging": "NUXT_PUBLIC_INDEXABLE=false NITRO_PRESET=cloudflare_module nuxt build && node scripts/prepare-cloudflare-output.mjs && node scripts/check-cloudflare-output.mjs staging",
    "build:nuxt:cloudflare:production": "NUXT_PUBLIC_INDEXABLE=true NITRO_PRESET=cloudflare_module nuxt build && node scripts/prepare-cloudflare-output.mjs && node scripts/check-cloudflare-output.mjs production",
    "build:lighthouse": "NUXT_PUBLIC_POSTHOG_KEY= VITE_POSTHOG_KEY= nuxt build",
    "check:bundle": "node --test tests/bundle-size.test.mjs && node scripts/check-bundle-size.mjs",
    "preview": "nuxt preview",
    "preview:nuxt": "nuxt preview",
    "type-check": "tsc --noEmit -p tsconfig.tests.json",
    "type-check:nuxt": "nuxt typecheck",
    "test": "nuxt prepare && vitest run",
    "test:nuxt:seo": "node --test tests/seo/nuxt-seo.test.mjs",
    "test:watch": "nuxt prepare && vitest",
    "test:coverage": "nuxt prepare && vitest run --coverage",
    "test:e2e": "playwright test --config=playwright.nuxt.config.ts",
    "test:e2e:chromium": "playwright test --config=playwright.nuxt.config.ts --project=nuxt-chromium --project=nuxt-mobile-chrome",
    "test:e2e:a11y": "playwright test --config=playwright.nuxt.config.ts --grep @a11y",
    "test:lighthouse": "npm run build:lighthouse && node scripts/run-lighthouse.mjs",
    "test:lighthouse:policy": "node --test tests/lighthouse-policy.test.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "deploy:nuxt:staging": "npm run build:nuxt:cloudflare:staging && wrangler deploy --env staging",
    "deploy:nuxt:production": "npm run build:nuxt:cloudflare:production && wrangler deploy --env production",
    "test:dependency-security": "node --test tests/dependency-security.test.mjs tests/audit-dependencies.test.mjs tests/braces-security.test.mjs"
  },
  "dependencies": {
    "@nuxtjs/sitemap": "8.6.2",
    "@unhead/vue": "^2.1.1",
    "@uswds/uswds": "^3.14.0",
    "maplibre-gl": "^6.14.0",
    "nuxt": "^4.6.2",
    "posthog-js": "^1.438.12",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "node-forge": "file:vendor/node-forge-1.4.1-philly.1.tgz",
    "braces": "file:vendor/braces-3.0.4-philly.1.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^26.1.0",
    "lighthouse": "13.5.0",
    "sass-embedded": "^1.105.2",
    "typescript": "^5.5.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13",
    "wrangler": "4.151.1"
  },
  "overrides": {
    "node-forge": "$node-forge",
    "brace-expansion@^2.0.0": "2.1.7",
    "brace-expansion@^5.0.0": "5.0.12",
    "devalue": "5.9.3",
    "dompurify": "3.4.17",
    "simple-git": "4.0.2",
    "seroval": "1.6.7",
    "postcss-selector-parser": "7.1.6",
    "miniflare": {
      "undici": "7.30.1"
    },
    "braces": "$braces"
  }
}
