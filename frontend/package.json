{
  "name": "philly-gun-violence-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:cloudflare": "npm run build:cloudflare:staging",
    "build:cloudflare:staging": "NUXT_PUBLIC_INDEXABLE=false NITRO_PRESET=cloudflare_module nuxt build && node scripts/prepare-cloudflare-output.mjs && node scripts/check-cloudflare-output.mjs staging",
    "build:cloudflare:production": "NUXT_PUBLIC_INDEXABLE=true NITRO_PRESET=cloudflare_module nuxt build && node scripts/prepare-cloudflare-output.mjs && node scripts/check-cloudflare-output.mjs production",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "preview": "nuxt preview",
    "type-check": "nuxt typecheck && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:seo": "node --test tests/seo/nuxt-seo.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=nuxt-chromium",
    "test:e2e:a11y": "playwright test --grep @a11y",
    "test:lighthouse": "npm run build && node scripts/run-lighthouse.mjs",
    "test:lighthouse:policy": "node --test tests/lighthouse-policy.test.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "deploy:staging": "npm run build:cloudflare:staging && wrangler deploy --env staging",
    "deploy:production": "npm run build:cloudflare:production && wrangler deploy --env production",
    "test:dependency-security": "node --test tests/dependency-security.test.mjs"
  },
  "dependencies": {
    "@nuxtjs/sitemap": "8.5.1",
    "@uswds/uswds": "^3.14.0",
    "maplibre-gl": "^6.11.2",
    "nuxt": "^4.5.2",
    "posthog-js": "^1.434.14",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "node-forge": "file:vendor/node-forge-1.4.1-philly.1.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^26.1.0",
    "lighthouse": "13.5.0",
    "sass-embedded": "^1.105.0",
    "typescript": "^5.5.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "4.144.0"
  },
  "overrides": {
    "node-forge": "$node-forge",
    "brace-expansion@^2.0.0": "2.1.7",
    "brace-expansion@^5.0.0": "5.0.12",
    "devalue": "5.9.3",
    "dompurify": "3.4.16"
  }
}
