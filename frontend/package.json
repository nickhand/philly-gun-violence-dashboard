{
  "name": "philly-gun-violence-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --config vite.legacy.config.ts",
    "dev:legacy": "vite --config vite.legacy.config.ts",
    "dev:nuxt": "nuxt dev",
    "build": "vue-tsc --noEmit && vite build --config vite.legacy.config.ts && node scripts/generate-seo-content.mjs",
    "build:legacy": "vue-tsc --noEmit && vite build --config vite.legacy.config.ts && node scripts/generate-seo-content.mjs",
    "build:nuxt": "nuxt build",
    "build:nuxt:cloudflare": "npm run build:nuxt:cloudflare:staging",
    "build:nuxt:cloudflare:staging": "NUXT_PUBLIC_INDEXABLE=false NITRO_PRESET=cloudflare_module nuxt build && node scripts/prepare-cloudflare-output.mjs && node scripts/check-cloudflare-output.mjs staging",
    "build:nuxt:cloudflare:production": "NUXT_PUBLIC_INDEXABLE=true NITRO_PRESET=cloudflare_module nuxt build && node scripts/prepare-cloudflare-output.mjs && node scripts/check-cloudflare-output.mjs production",
    "build:lighthouse": "vue-tsc --noEmit && VITE_LIGHTHOUSE=true VITE_API_BASE_URL= VITE_POSTHOG_KEY= vite build --config vite.legacy.config.ts",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview --config vite.legacy.config.ts",
    "preview:nuxt": "nuxt preview",
    "type-check": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "type-check:nuxt": "nuxt typecheck",
    "test": "vitest run",
    "test:nuxt:seo": "node --test tests/seo/nuxt-seo.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium --project=mobile-chrome",
    "test:e2e:a11y": "playwright test --grep @a11y",
    "test:e2e:nuxt": "playwright test --config=playwright.nuxt.config.ts",
    "test:e2e:nuxt:chromium": "playwright test --config=playwright.nuxt.config.ts --project=nuxt-chromium",
    "test:lighthouse": "npm run build:lighthouse && node scripts/run-lighthouse.mjs",
    "test:lighthouse:policy": "node --test tests/lighthouse-policy.test.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "deploy:nuxt:staging": "npm run build:nuxt:cloudflare:staging && wrangler deploy --env staging",
    "deploy:nuxt:production": "npm run build:nuxt:cloudflare:production && wrangler deploy --env production"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@nuxtjs/sitemap": "8.0.15",
    "@types/d3-transition": "^3.0.9",
    "@types/maplibre-gl": "^1.13.2",
    "@unhead/vue": "^2.1.1",
    "@uswds/uswds": "^3.13.0",
    "arquero": "^8.0.3",
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-format": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "3.1.0",
    "d3-selection": "^3.0.0",
    "d3-time-format": "^4.1.0",
    "d3-transition": "^3.0.1",
    "maplibre-gl": "^2.4.0",
    "nuxt": "^4.5.2",
    "pinia": "3.0.4",
    "posthog-js": "^1.318.1",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "vuetify": "^3.7.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-format": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-time-format": "^4.0.3",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^20.12.12",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^26.1.0",
    "lighthouse": "13.4.1",
    "sass-embedded": "^1.100.0",
    "typescript": "^5.5.3",
    "vite": "^7.3.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vite-plugin-vuetify": "^2.1.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.2.2",
    "wrangler": "4.120.1"
  }
}
