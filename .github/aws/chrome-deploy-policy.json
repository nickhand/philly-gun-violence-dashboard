{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "EcrLogin", "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*"},
    {"Sid": "OnlyScraperImage", "Effect": "Allow", "Action": [
      "ecr:DescribeRepositories", "ecr:ListImages", "ecr:DescribeImages", "ecr:BatchGetImage",
      "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability", "ecr:InitiateLayerUpload",
      "ecr:UploadLayerPart", "ecr:CompleteLayerUpload", "ecr:PutImage", "ecr:DescribeImageScanFindings"
    ], "Resource": "arn:aws:ecr:us-east-1:985454606291:repository/ujs-scraper"},
    {"Sid": "ReadCluster", "Effect": "Allow", "Action": "ecs:DescribeClusters",
      "Resource": "arn:aws:ecs:us-east-1:985454606291:cluster/ujs-scraper"},
    {"Sid": "ListClusterTasks", "Effect": "Allow", "Action": "ecs:ListTasks", "Resource": "*",
      "Condition": {"ArnEquals": {"ecs:cluster": "arn:aws:ecs:us-east-1:985454606291:cluster/ujs-scraper"}}},
    {"Sid": "ReadTasks", "Effect": "Allow", "Action": "ecs:DescribeTasks",
      "Resource": "arn:aws:ecs:us-east-1:985454606291:task/ujs-scraper/*"},
    {"Sid": "DefinitionsAndNetworkRead", "Effect": "Allow",
      "Action": ["ecs:DescribeTaskDefinition", "ecs:RegisterTaskDefinition", "ec2:DescribeNetworkInterfaces"], "Resource": "*"},
    {"Sid": "LaunchOnlyScraperProbes", "Effect": "Allow", "Action": "ecs:RunTask",
      "Resource": ["arn:aws:ecs:us-east-1:985454606291:task-definition/ujs-scraper:*",
                   "arn:aws:ecs:us-east-1:985454606291:task-definition/ujs-scraper-monitor:*"],
      "Condition": {"ArnEquals": {"ecs:cluster": "arn:aws:ecs:us-east-1:985454606291:cluster/ujs-scraper"},
                    "Bool": {"ecs:enable-execute-command": "false"},
                    "StringEquals": {"aws:RequestTag/ManagedBy": "chrome-deploy"}}},
    {"Sid": "ReadDefinitionTags", "Effect": "Allow", "Action": "ecs:ListTagsForResource",
      "Resource": ["arn:aws:ecs:us-east-1:985454606291:task-definition/ujs-scraper:*",
                   "arn:aws:ecs:us-east-1:985454606291:task-definition/ujs-scraper-monitor:*"]},
    {"Sid": "TagProbesAndDefinitions", "Effect": "Allow", "Action": "ecs:TagResource",
      "Resource": ["arn:aws:ecs:us-east-1:985454606291:task/ujs-scraper/*",
                   "arn:aws:ecs:us-east-1:985454606291:task-definition/ujs-scraper:*",
                   "arn:aws:ecs:us-east-1:985454606291:task-definition/ujs-scraper-monitor:*"],
      "Condition": {"StringEquals": {"ecs:CreateAction": ["RunTask", "RegisterTaskDefinition"]}}},
    {"Sid": "StopOnlyDeploymentProbes", "Effect": "Allow", "Action": "ecs:StopTask",
      "Resource": "arn:aws:ecs:us-east-1:985454606291:task/ujs-scraper/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/ManagedBy": "chrome-deploy"}}},
    {"Sid": "PassExistingScraperRoles", "Effect": "Allow", "Action": "iam:PassRole",
      "Resource": ["arn:aws:iam::985454606291:role/ujs-scraper-task",
                   "arn:aws:iam::985454606291:role/ujs-scraper-execution"],
      "Condition": {"StringEquals": {"iam:PassedToService": "ecs-tasks.amazonaws.com"}}},
    {"Sid": "CourtEvidenceRead", "Effect": "Allow", "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::philly-gun-violence-dashboard/ujs-scraper/*"},
    {"Sid": "CourtEvidenceList", "Effect": "Allow", "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::philly-gun-violence-dashboard",
      "Condition": {"StringLike": {"s3:prefix": "ujs-scraper/*"}}},
    {"Sid": "AtomicReleaseOnly", "Effect": "Allow", "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::philly-gun-violence-dashboard/ujs-scraper/deployment/active.json"},
    {"Sid": "QueueReadOnly", "Effect": "Allow", "Action": ["sqs:GetQueueUrl", "sqs:GetQueueAttributes"],
      "Resource": "arn:aws:sqs:us-east-1:985454606291:ujs-incidents"},
    {"Sid": "ProbeLogs", "Effect": "Allow", "Action": "logs:GetLogEvents",
      "Resource": "arn:aws:logs:us-east-1:985454606291:log-group:/ecs/ujs-scraper:log-stream:*"}
  ]
}
