# Template for pure Python or HTTP-based scrapers.
FROM python:3.13.17-slim-trixie@sha256:fe14fd57a4c0361110eaa0c284112b189750bcb43fb04bb5d1ee7b7744027ccf
COPY --from=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff /uv /uvx /bin/

# Distrust both the compromised emSign root and its AAA cross-signing path.
# https://emudhra.we-have-a-problem.com/#workarounds
RUN sed -i \
        -e 's|^mozilla/emSign_ECC_Root_CA_-_G3.crt|!&|' \
        -e 's|^mozilla/Comodo_AAA_Services_root.crt|!&|' \
        /etc/ca-certificates.conf \
    && update-ca-certificates --fresh \
    && test ! -e /etc/ssl/certs/emSign_ECC_Root_CA_-_G3.pem \
    && test ! -e /etc/ssl/certs/Comodo_AAA_Services_root.pem

# The interpreter and ensurepip seed must both carry the fixed vendored CA bundle.
RUN python -c "import ensurepip, pip, pip._vendor.certifi as certifi; assert tuple(map(int, pip.__version__.split('.'))) >= (26, 2, 2); assert tuple(map(int, ensurepip.version().split('.'))) >= (26, 2, 2); assert tuple(map(int, certifi.__version__.split('.'))) >= (2026, 10, 19)"

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_NO_DEV=1

COPY pyproject.toml uv.lock README.md /app/
COPY src/ /app/src/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked

ENV PATH="/app/.venv/bin:$PATH"
ENV HOME=/tmp/app-home
ENV XDG_CACHE_HOME=/tmp/app-home/.cache
ENV XDG_CONFIG_HOME=/tmp/app-home/.config
ENV TMPDIR=/tmp
ENV PYTHONDONTWRITEBYTECODE=1

RUN chmod 1777 /tmp \
    && groupadd --system app \
    && useradd --system --gid app --home-dir /tmp/app-home --no-create-home \
        --shell /usr/sbin/nologin app

VOLUME ["/tmp"]
ENTRYPOINT []
USER app
CMD ["my-scraper", "scraper", "worker"]
