# Template for monorepos with local packages.
FROM python:3.13-slim-trixie@sha256:ffb752e139c0a19692a43af8d8523b274222dd68eebad5d583b45c2201c6e30a
COPY --from=ghcr.io/astral-sh/uv:0.12.0@sha256:606e70c71c852d03f611b1e56a195d08648507018a7057fab82c4974c4eae105 /uv /uvx /bin/

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_NO_DEV=1
ENV UV_PROJECT_ENVIRONMENT=/app/.venv

# Copy lockfiles and package metadata first for dependency-layer caching.
COPY shared-lib/pyproject.toml shared-lib/uv.lock shared-lib/README.md /app/shared-lib/
COPY shared-lib/src/ /app/shared-lib/src/
COPY scraper/pyproject.toml scraper/uv.lock scraper/README.md /app/scraper/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --project /app/shared-lib --locked --no-install-project && \
    uv sync --project /app/scraper --locked --no-install-project

COPY shared-lib/ /app/shared-lib/
COPY scraper/ /app/scraper/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --project /app/shared-lib --locked && \
    uv sync --project /app/scraper --locked

ENV PATH="/app/.venv/bin:$PATH"
ENV HOME=/tmp/app-home
ENV XDG_CACHE_HOME=/tmp/app-home/.cache
ENV XDG_CONFIG_HOME=/tmp/app-home/.config
ENV TMPDIR=/tmp
ENV PYTHONDONTWRITEBYTECODE=1

RUN chmod 1777 /tmp \
    && groupadd --system app \
    && useradd --system --gid app --home-dir /tmp/app-home --no-create-home \
        --shell /usr/sbin/nologin app

VOLUME ["/tmp"]
ENTRYPOINT []
WORKDIR /app/scraper
USER app
CMD ["my-scraper", "scraper", "worker"]
