# -- Runtime -------------------------------------------------------------------
# Local code loads this file when ENV is not "prod". ECS/GitHub Actions should
# set ENV=prod and provide configuration through task/workflow environment.
ENV=dev

# -- Shared AWS / S3 -----------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
S3_BUCKET=philly-gun-violence-dashboard
S3_SCRAPER_PREFIX=ujs-scraper
S3_PROCESSED_PREFIX=processed
S3_REFERENCE_PREFIX=reference

# Backward-compatible alias accepted by S3Config. Prefer S3_BUCKET for new config.
AWS_BUCKET_NAME=philly-gun-violence-dashboard

# -- Local AWS credentials -----------------------------------------------------
# Local ETL/dev commands use boto3's credential chain. Prefer a named profile
# locally. GitHub Actions uses OIDC, and ECS uses task roles.
AWS_PROFILE=your-profile-name

# -- Courts scraper queues -----------------------------------------------------
SQS_QUEUE_NAME=ujs-incidents
SQS_DLQ_NAME=ujs-incidents-dlq

# -- Courts scraper ECS submitter ---------------------------------------------
ECS_CLUSTER_NAME=ujs-scraper
# Exact digest-backed revision; bare family names are intentionally rejected.
ECS_TASK_DEFINITION=ujs-scraper:42
# Separate monitor definition. This definition may receive the GitHub dispatch
# token; it must never be reused for workers.
ECS_MONITOR_TASK_DEFINITION=ujs-scraper-monitor:17
ECS_CONTAINER_NAME=ujs-scraper
ECS_TASK_COUNT=9

# Comma-separated; parsed by SubmitterConfig.
ECS_SUBNET_IDS=subnet-xxxxxxxx,subnet-yyyyyyyy
ECS_SECURITY_GROUP_IDS=sg-xxxxxxxx

# -- Courts scraper worker runtime --------------------------------------------
RUN_ID=unknown
FORCE_RESCRAPE=false
SOFT_BLOCKED_DELAY_MIN=300
SOFT_BLOCKED_DELAY_MAX=900

# -- Courts monitor workflow dispatch -----------------------------------------
# GITHUB_REPOSITORY is passed from GitHub Actions when the ECS monitor task is
# launched. If you run the monitor locally, set it to "owner/repo".
GITHUB_REPOSITORY=your-github-owner/your-github-repo
GITHUB_WORKFLOW_FILE=courts-process.yml

# Store GITHUB_DISPATCH_TOKEN in AWS Secrets Manager or SSM Parameter Store for
# ECS task definitions. The fine-grained token needs only Actions: write for
# this repository (not Contents: write). Do not commit a real token here.
GITHUB_DISPATCH_TOKEN=your-github-actions-token

# -- API / Fly.io local dev ----------------------------------------------------
# These are set as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in Fly secrets
# (see `just fly-secrets-api`). Locally they're read via the FLY_ prefix so
# they don't collide with the ETL profile credentials above.
FLY_AWS_ACCESS_KEY_ID=your-aws-access-key-id
FLY_AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -- Fly.io deployment ---------------------------------------------------------
FLY_API_TOKEN=your-fly-token

# Fine-grained token used only by the external Fly scheduler to dispatch the
# five allowlisted GitHub Actions workflows. It needs Actions: write for this
# repository; it is distinct from the courts monitor workflow-dispatch token.
FLY_GITHUB_PAT=your-github-actions-token
