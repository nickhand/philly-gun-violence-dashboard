# ── Shared ────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket-name

# ── ETL / Courts Scraper (local dev — uses a named profile) ───────────────────
# The scraper submits ECS tasks and reads/writes SQS, so it needs a profile with
# broader permissions than the read-only API key.
AWS_PROFILE=your-profile-name
AWS_ACCOUNT_ID=123456789012

# ECS networking — comma-separated
ECS_SUBNET_IDS=subnet-xxxxxxxx,subnet-yyyyyyyy
ECS_SECURITY_GROUP_IDS=sg-xxxxxxxx

# ── API / Fly.io (local dev — uses a scoped key pair) ─────────────────────────
# These are set as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in Fly secrets
# (see `just fly-secrets-api`). Locally they're read via the FLY_ prefix so
# they don't collide with the ETL profile credentials above.
FLY_AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
FLY_AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Fly.io deployment ─────────────────────────────────────────────────────────
FLY_API_TOKEN=your-fly-token

# ── GitHub Actions ────────────────────────────────────────────────────────────
GITHUB_TOKEN=your-github-pat
